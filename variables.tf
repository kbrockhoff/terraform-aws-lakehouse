# ----
# Common
# ----

variable "enabled" {
  description = "Set to false to prevent the module from creating any resources"
  type        = bool
  default     = true
}

variable "name_prefix" {
  description = "Organization unique prefix to use for resource names. Designed to be generated by terraform-external-context module."
  type        = string

  validation {
    condition     = can(regex("^[a-z][a-z0-9-]{0,22}[a-z0-9]$", var.name_prefix))
    error_message = "The name_prefix value must start with a lowercase letter, followed by 0 to 22 alphanumeric or hyphen characters, ending with alphanumeric, for a total length of 2 to 24 characters."
  }
}

variable "tags" {
  description = "Tags/labels to apply to all resources (usually generated by terraform-external-context)."
  type        = map(string)
  default     = {}
}

variable "data_tags" {
  description = "Additional tags to apply only to resources containing data-at-rest (S3 and S3 Tables buckets), beyond the common tags (usually generated by terraform-external-context)."
  type        = map(string)
  default     = {}
}

variable "environment_type" {
  description = "Environment type for resource configuration defaults. Select 'None' to use individual config values."
  type        = string
  default     = "Development"

  validation {
    condition = contains([
      "None", "Ephemeral", "Development", "Testing", "UAT", "Production", "MissionCritical"
    ], var.environment_type)
    error_message = "Environment type must be one of: None, Ephemeral, Development, Testing, UAT, Production, MissionCritical."
  }
}

variable "zones_config" {
  description = "Data zones shared by the platform. Each zone becomes an S3 table bucket named <name_prefix>-<zone>."
  type = object({
    zones = list(string)
  })
  default = {
    zones = ["raw", "curated", "consumption"]
  }

  validation {
    condition     = length(var.zones_config.zones) > 0 && length(distinct(var.zones_config.zones)) == length(var.zones_config.zones)
    error_message = "zones_config.zones must be non-empty and contain no duplicates."
  }

  validation {
    condition     = alltrue([for z in var.zones_config.zones : can(regex("^[a-z0-9]([a-z0-9-]*[a-z0-9])?$", z))])
    error_message = "Zone names must be lowercase alphanumeric or hyphens (no underscores), starting and ending with an alphanumeric character, because they become table bucket names."
  }

  validation {
    condition     = alltrue([for z in var.zones_config.zones : length(var.name_prefix) + 1 + length(z) <= 63])
    error_message = "Every table bucket name <name_prefix>-<zone> must be at most 63 characters."
  }
}

# ----
# Catalog integration and governance
# ----

variable "catalog_integration_config" {
  description = "Account-level Lake Formation integration for S3 Tables. Exactly one deployment per account and Region sets enabled = true; secondary deployments pass the owner's data access role ARN."
  type = object({
    enabled              = bool
    data_access_role_arn = string
  })
  default = {
    enabled              = true
    data_access_role_arn = ""
  }

  validation {
    condition = (
      (var.catalog_integration_config.enabled && var.catalog_integration_config.data_access_role_arn == "") ||
      (!var.catalog_integration_config.enabled && can(regex("^arn:aws[a-z-]*:iam::[0-9]{12}:role/.+$", var.catalog_integration_config.data_access_role_arn)))
    )
    error_message = "data_access_role_arn must be empty when enabled is true, and a valid IAM role ARN when enabled is false."
  }
}

variable "account_settings_config" {
  description = <<-EOT
    Account- and Region-wide Lake Formation and Glue Data Catalog settings, managed by exactly one
    deployment per account and Region (the owner). Every non-default value weakens or changes an
    account-wide control:
    - owner: whether this deployment manages the settings. Null follows catalog_integration_config.enabled.
    - cross_account_version: Lake Formation cross-account version. 4 is the minimum for sharing
      federated (S3 Tables) catalogs. 5 is irreversible; a custom cross-account grantor policy then
      also needs ram:AssociateResourceSharePermission and ram:ListResourceSharePermissions.
    - data_lake.allow_external_data_filtering: lets EMR clusters in the allow-listed accounts filter
      Lake Formation data themselves (needed for SageMaker Unified Studio EMR fine-grained access).
    - data_lake.authorized_session_tag_values: session tag values a trusted engine must present
      (for example "Amazon EMR").
    - data_lake.allow_full_table_external_data_access: third-party engines get credentials without
      session tags when the caller has full table access (needed by IAM-based Unified Studio domains).
    - data_lake.trusted_resource_owners: accounts allowed to see caller ARNs in their CloudTrail logs.
    - catalog_encryption.key_access_mode: service_role (one Glue role uses the key) or per_caller
      (every caller needs key permissions and appears in key-use audit records).
    - catalog_encryption.kms_key_arn: an existing catalog-metadata key. Empty creates a dedicated key.
      It must never be the platform key or a tenant key.
    - catalog_encryption.key_deletion_principal_arns: break-glass principals that may schedule
      deletion of, or disable, the catalog key. Empty makes the protection absolute.
    - catalog_resource_policy: optional Glue resource policy; only RAM sharing plus Deny statements.
    - permissions_boundary_arn: boundary for the module-created Lake Formation and Glue roles.
    - s3tables_catalog.allow_full_table_external_data_access (default true): set on s3tablescatalog
      when the owner creates it, which happens only when it is missing; an existing catalog is never
      changed or deleted. True lets third-party engines get credentials without session tags when
      the caller has full table access.
  EOT
  type = object({
    owner                 = optional(bool)
    cross_account_version = optional(number, 4)
    data_lake = optional(object({
      allow_external_data_filtering         = optional(bool, false)
      external_data_filtering_allow_list    = optional(list(string), [])
      authorized_session_tag_values         = optional(list(string), [])
      allow_full_table_external_data_access = optional(bool, false)
      trusted_resource_owners               = optional(list(string), [])
    }), {})
    catalog_encryption = optional(object({
      key_access_mode             = optional(string, "service_role")
      kms_key_arn                 = optional(string, "")
      additional_key_user_arns    = optional(list(string), [])
      key_deletion_principal_arns = optional(list(string), [])
    }), {})
    catalog_resource_policy = optional(object({
      enabled           = optional(bool, false)
      deny_policy_jsons = optional(list(string), [])
    }), {})
    permissions_boundary_arn = optional(string, "")
    s3tables_catalog = optional(object({
      allow_full_table_external_data_access = optional(bool, true)
    }), {})
  })
  default = {}

  validation {
    condition     = contains([4, 5], var.account_settings_config.cross_account_version)
    error_message = "cross_account_version must be 4 or 5. Version 4 is the minimum for sharing S3 Tables catalogs, and versions are never lowered."
  }

  validation {
    condition     = contains(["service_role", "per_caller"], var.account_settings_config.catalog_encryption.key_access_mode)
    error_message = "catalog_encryption.key_access_mode must be service_role or per_caller."
  }

  validation {
    condition = (
      var.account_settings_config.catalog_encryption.kms_key_arn == "" ||
      can(regex("^arn:aws[a-z-]*:kms:[a-z0-9-]+:[0-9]{12}:key/[0-9a-f-]+$", var.account_settings_config.catalog_encryption.kms_key_arn))
    )
    error_message = "catalog_encryption.kms_key_arn must be empty (create a dedicated key) or a KMS key ARN."
  }

  validation {
    condition = alltrue([
      for a in concat(
        var.account_settings_config.catalog_encryption.additional_key_user_arns,
        var.account_settings_config.catalog_encryption.key_deletion_principal_arns,
      ) : can(regex("^arn:aws[a-z-]*:iam::[0-9]{12}:(role|user)/[^*]+$", a))
    ])
    error_message = "additional_key_user_arns and key_deletion_principal_arns entries must be IAM role or user ARNs without wildcards."
  }

  validation {
    condition     = length(var.account_settings_config.catalog_encryption.additional_key_user_arns) <= 100
    error_message = "catalog_encryption.additional_key_user_arns may hold at most 100 entries (KMS key policy size limit)."
  }

  validation {
    condition = alltrue([
      for a in concat(
        var.account_settings_config.data_lake.external_data_filtering_allow_list,
        var.account_settings_config.data_lake.trusted_resource_owners,
      ) : can(regex("^[0-9]{12}$", a))
    ])
    error_message = "external_data_filtering_allow_list and trusted_resource_owners entries must be 12-digit AWS account IDs."
  }

  validation {
    condition = (
      !var.account_settings_config.data_lake.allow_external_data_filtering ||
      length(var.account_settings_config.data_lake.external_data_filtering_allow_list) > 0
    )
    error_message = "allow_external_data_filtering requires a non-empty external_data_filtering_allow_list; no account is trusted implicitly."
  }

  validation {
    condition = alltrue([
      for j in var.account_settings_config.catalog_resource_policy.deny_policy_jsons :
      can(jsondecode(j)) &&
      length(try(flatten([jsondecode(j).Statement]), [])) > 0 &&
      alltrue([for st in try(flatten([jsondecode(j).Statement]), []) : try(st.Effect, "") == "Deny"])
    ])
    error_message = "Every catalog_resource_policy.deny_policy_jsons entry must be a JSON policy document whose statements all have Effect = Deny."
  }

  validation {
    condition = (
      var.account_settings_config.permissions_boundary_arn == "" ||
      can(regex("^arn:aws[a-z-]*:iam::([0-9]{12}|aws):policy/.+$", var.account_settings_config.permissions_boundary_arn))
    )
    error_message = "permissions_boundary_arn must be empty or an IAM policy ARN."
  }
}

variable "studio_config" {
  description = "SageMaker Unified Studio support. When enabled, integration_principal_arns (the blueprint provisioning role AmazonSageMakerProvisioning-<account>, the domain manage-access role AmazonSageMakerManageAccess-<region>-<domain_id>, and, for IAM-based domains, the domain execution role) become Lake Formation data-lake admins so the studio can fulfill subscriptions. The module creates no studio resources."
  type = object({
    enabled                    = optional(bool, false)
    integration_principal_arns = optional(list(string), [])
  })
  default = {}

  validation {
    condition     = !var.studio_config.enabled || length(var.studio_config.integration_principal_arns) > 0
    error_message = "studio_config.enabled requires at least one integration_principal_arns entry."
  }

  validation {
    condition     = var.studio_config.enabled || length(var.studio_config.integration_principal_arns) == 0
    error_message = "studio_config.integration_principal_arns must be empty when studio support is disabled."
  }

  validation {
    condition     = alltrue([for a in var.studio_config.integration_principal_arns : can(regex("^arn:aws[a-z-]*:iam::[0-9]{12}:role/[^*]+$", a))])
    error_message = "Every studio_config.integration_principal_arns entry must be an IAM role ARN without wildcards."
  }
}

variable "sharing_config" {
  description = "Same-Region cross-account sharing. consumer_accounts is the approved list, keyed by 12-digit account ID; tenants may share only with these accounts. outside_organization marks an account outside this organization, whose administrator must accept the RAM share invitation."
  type = object({
    consumer_accounts = optional(map(object({
      purpose              = string
      outside_organization = optional(bool, false)
    })), {})
  })
  default = {}

  validation {
    condition     = alltrue([for id in keys(var.sharing_config.consumer_accounts) : can(regex("^[0-9]{12}$", id))])
    error_message = "sharing_config.consumer_accounts keys must be 12-digit AWS account IDs."
  }

  validation {
    condition     = alltrue([for a in values(var.sharing_config.consumer_accounts) : length(trimspace(a.purpose)) > 0])
    error_message = "Every sharing_config.consumer_accounts entry needs a non-empty purpose."
  }

  validation {
    condition     = length(var.sharing_config.consumer_accounts) <= 50
    error_message = "sharing_config.consumer_accounts may hold at most 50 accounts."
  }
}

variable "governance_config" {
  description = "Lake Formation governance: data-lake admins, read-only admins, the platform LF-tag vocabularies for sensitivity, regulations, and domains, and the principals exempt from the table-bucket deny on direct storage access (each exemption bypasses Lake Formation for table data)."
  type = object({
    admin_principal_arns           = list(string)
    read_only_admin_principal_arns = optional(list(string), [])
    sensitivity_values             = optional(list(string), ["public", "internal", "confidential", "restricted"])
    regulation_values              = optional(list(string), ["gdpr", "hipaa", "pci_dss"])
    domain_values                  = optional(list(string), ["general"])
    shared_storage_classification  = optional(string)
    writer_drop_enabled            = optional(bool)

    direct_access_exempt_principal_arns = optional(list(string), [])
  })
  default = {
    admin_principal_arns = []
  }

  validation {
    condition     = alltrue([for a in var.governance_config.admin_principal_arns : can(regex("^arn:aws[a-z-]*:iam::[0-9]{12}:(role|user)/.+$", a))])
    error_message = "Every admin_principal_arns entry must be an IAM role or user ARN."
  }

  validation {
    condition     = alltrue([for a in var.governance_config.read_only_admin_principal_arns : can(regex("^arn:aws[a-z-]*:iam::[0-9]{12}:(role|user)/.+$", a))])
    error_message = "Every read_only_admin_principal_arns entry must be an IAM role or user ARN."
  }

  validation {
    condition     = length(setintersection(var.governance_config.admin_principal_arns, var.governance_config.read_only_admin_principal_arns)) == 0
    error_message = "A principal cannot be both a data-lake admin and a read-only admin."
  }

  validation {
    condition = (
      length(var.governance_config.sensitivity_values) > 0 &&
      length(distinct(var.governance_config.sensitivity_values)) == length(var.governance_config.sensitivity_values)
    )
    error_message = "sensitivity_values must be non-empty and unique, ordered least to most sensitive."
  }

  validation {
    condition = (
      length(var.governance_config.regulation_values) <= 20 &&
      length(distinct(var.governance_config.regulation_values)) == length(var.governance_config.regulation_values) &&
      alltrue([for r in var.governance_config.regulation_values : can(regex("^[a-z0-9_]{1,40}$", r))])
    )
    error_message = "regulation_values must be unique, at most 20 entries (each becomes an LF-tag key), each matching ^[a-z0-9_]{1,40}$."
  }

  validation {
    condition = (
      length(var.governance_config.domain_values) > 0 &&
      length(distinct(var.governance_config.domain_values)) == length(var.governance_config.domain_values) &&
      alltrue([for d in var.governance_config.domain_values : can(regex("^[a-z0-9_-]{1,64}$", d))])
    )
    error_message = "domain_values must be non-empty and unique, each matching ^[a-z0-9_-]{1,64}$. The first entry is the default tenant domain."
  }

  validation {
    condition = (
      var.governance_config.shared_storage_classification == null ||
      contains(var.governance_config.sensitivity_values, coalesce(var.governance_config.shared_storage_classification, "-"))
    )
    error_message = "shared_storage_classification must be one of sensitivity_values, or null for the most sensitive value."
  }

  validation {
    condition = (
      length(var.governance_config.direct_access_exempt_principal_arns) <= 20 &&
      alltrue([for a in var.governance_config.direct_access_exempt_principal_arns : can(regex("^arn:aws[a-z-]*:iam::[0-9]{12}:(role|user)/[^*]+$", a))])
    )
    error_message = "direct_access_exempt_principal_arns may hold at most 20 IAM role or user ARNs, without wildcards."
  }

  validation {
    condition     = var.environment_type != "None" || var.governance_config.writer_drop_enabled != null
    error_message = "governance_config.writer_drop_enabled is required when environment_type is None."
  }
}

# ----
# Tenants
# ----

# Only the key format is validated here. Every other tenant rule lives in modules/tenant
# (var.tenant), so platform-applied and standalone tenants are validated identically.
# This object type must stay identical to modules/tenant var.tenant.
variable "tenants" {
  description = "Tenants to provision with the platform, keyed by tenant name. Each entry is applied through modules/tenant."
  type = map(object({
    owner                 = string
    sensitivity           = string
    regulations           = optional(set(string), [])
    domain                = optional(string)
    zones                 = optional(list(string))
    compliance_frameworks = optional(set(string), [])
    stewards              = optional(list(string), [])
    writers = optional(map(object({
      principal_arn = string
      zones         = optional(list(string))
    })), {})
    readers = optional(map(object({
      principal_arn      = string
      zones              = optional(list(string))
      sensitivity_values = list(string)
      regulations        = optional(set(string), [])
      domains            = optional(list(string))
    })), {})
    metadata_readers = optional(map(object({
      principal_arn = string
      zones         = optional(list(string))
    })), {})
    metadata_writers = optional(map(object({
      principal_arn = string
      zones         = optional(list(string))
    })), {})
    row_filters = optional(map(object({
      reader                = string
      zone                  = string
      table                 = string
      row_filter_expression = string
      column_names          = optional(list(string))
    })), {})
    bytes_scanned_cutoff_per_query = optional(number)
    scanned_bytes_alarm_threshold  = optional(number)
    dedicated_storage              = optional(bool, false)
    dml_workgroup_enabled          = optional(bool)
    shares = optional(map(object({
      account_id              = string
      zones                   = optional(list(string), ["consumption"])
      sensitivity_values      = list(string)
      regulations             = optional(set(string), [])
      domains                 = optional(list(string))
      compliance_acknowledged = optional(bool, false)
    })), {})
  }))
  default = {}

  validation {
    condition     = alltrue([for k in keys(var.tenants) : can(regex("^[a-z][a-z0-9]{1,31}$", k))])
    error_message = "Tenant names must match ^[a-z][a-z0-9]{1,31}$."
  }
}

# ----
# Storage and query
# ----

variable "storage_config" {
  description = "Table storage settings. Null values use the environment default."
  type = object({
    table_storage_class = optional(string)
  })
  default = {}

  validation {
    condition     = var.storage_config.table_storage_class == null || contains(["STANDARD", "INTELLIGENT_TIERING"], coalesce(var.storage_config.table_storage_class, "-"))
    error_message = "table_storage_class must be STANDARD or INTELLIGENT_TIERING."
  }

  validation {
    condition     = var.environment_type != "None" || var.storage_config.table_storage_class != null
    error_message = "storage_config.table_storage_class is required when environment_type is None."
  }
}

variable "query_config" {
  description = "Platform query defaults that tenants may override. Null values use the environment default. dml_workgroup_enabled adds a second workgroup per tenant for INSERT, UPDATE, DELETE, and MERGE, which a result-encrypted workgroup cannot run against S3 Tables."
  type = object({
    bytes_scanned_cutoff_per_query = optional(number)
    results_expiration_days        = optional(number)
    dml_workgroup_enabled          = optional(bool, false)
  })
  default = {}

  validation {
    condition     = var.query_config.bytes_scanned_cutoff_per_query == null || coalesce(var.query_config.bytes_scanned_cutoff_per_query, 0) >= 10485760
    error_message = "bytes_scanned_cutoff_per_query must be at least 10485760 (10 MB)."
  }

  validation {
    condition = var.query_config.results_expiration_days == null || (
      coalesce(var.query_config.results_expiration_days, 0) >= 1 && coalesce(var.query_config.results_expiration_days, 0) <= 3650
    )
    error_message = "results_expiration_days must be between 1 and 3650."
  }

  validation {
    condition = var.environment_type != "None" || (
      var.query_config.bytes_scanned_cutoff_per_query != null && var.query_config.results_expiration_days != null
    )
    error_message = "query_config values are required when environment_type is None."
  }
}

# ----
# Encryption
# ----

variable "encryption_config" {
  description = "Configuration object for encryption settings and KMS key management. key_administrator_arns are named key administrators on every key the module creates (platform, catalog metadata, and tenant keys), alongside the deploying role; the account root gets read-only access only."
  type = object({
    create_kms_key               = bool
    kms_key_id                   = string
    kms_key_deletion_window_days = number
    key_administrator_arns       = optional(list(string), [])
  })
  default = {
    create_kms_key               = true
    kms_key_id                   = ""
    kms_key_deletion_window_days = 14
  }

  validation {
    condition = (
      (var.encryption_config.create_kms_key && var.encryption_config.kms_key_id == "") ||
      (!var.encryption_config.create_kms_key && var.encryption_config.kms_key_id != "")
    )
    error_message = "kms_key_id must be empty when create_kms_key is true, or provided when create_kms_key is false."
  }

  validation {
    condition     = var.encryption_config.kms_key_deletion_window_days >= 7 && var.encryption_config.kms_key_deletion_window_days <= 30
    error_message = "KMS key deletion window must be between 7 and 30 days when specified."
  }

  validation {
    condition     = alltrue([for a in var.encryption_config.key_administrator_arns : can(regex("^arn:aws[a-z-]*:iam::[0-9]{12}:(role|user)/[^*]+$", a))])
    error_message = "Every key_administrator_arns entry must be an IAM role or user ARN without wildcards."
  }

  validation {
    condition     = length(var.encryption_config.key_administrator_arns) <= 20
    error_message = "encryption_config.key_administrator_arns may hold at most 20 entries."
  }
}

# ----
# Monitoring
# ----

variable "monitoring_config" {
  description = "Configuration object for optional monitoring"
  type = object({
    enabled = bool
  })
  default = {
    enabled = false
  }
}

variable "alarms_config" {
  description = "Configuration object for metric alarms and notifications"
  type = object({
    enabled                 = bool
    create_sns_topic        = bool
    sns_topic_arn           = string
    scanned_bytes_threshold = optional(number)
  })
  default = {
    enabled          = false
    create_sns_topic = true
    sns_topic_arn    = ""
  }

  validation {
    condition     = var.environment_type != "None" || var.alarms_config.scanned_bytes_threshold != null
    error_message = "alarms_config.scanned_bytes_threshold is required when environment_type is None."
  }

  validation {
    condition = (
      (var.alarms_config.create_sns_topic && var.alarms_config.sns_topic_arn == "") ||
      (!var.alarms_config.create_sns_topic && var.alarms_config.sns_topic_arn != "")
    )
    error_message = "sns_topic_arn must be empty when create_sns_topic is true, or provided when create_sns_topic is false."
  }
}

# ----
# Cost Estimation
# ----

variable "cost_estimation_config" {
  description = "Configuration object for monthly cost estimation. catalog_kms_requests_per_month estimates Glue catalog metadata encryption requests to the catalog key in the deployment that owns the account settings."
  type = object({
    enabled                        = bool
    catalog_kms_requests_per_month = optional(number, 100000)
  })
  default = {
    enabled = true
  }

  validation {
    condition     = var.cost_estimation_config.catalog_kms_requests_per_month >= 0
    error_message = "catalog_kms_requests_per_month must be zero or positive."
  }
}
